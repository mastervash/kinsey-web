[Unit]
Description=maigret-web - OSINT person/username search (oci, tailnet-only)
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
User=mastervash
WorkingDirectory=/home/mastervash/maigret-web
EnvironmentFile=-/home/mastervash/.config/maigret-web.env
Environment=MW_HOST=100.78.113.1
Environment=MW_PORT=7580
Environment=MW_DATA_DIR=/home/mastervash/maigret-web/var
# bind fails until the tailscale IP exists
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do ip -4 addr show tailscale0 2>/dev/null | grep -q 100.78.113.1 && exit 0; sleep 2; done; exit 1'
ExecStart=/home/mastervash/maigret-web/.venv/bin/maigret-web
Restart=always
RestartSec=5
MemoryMax=1500M

[Install]
WantedBy=multi-user.target
